{
  "name": "manager-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "migrate:core": "knex migrate:latest --knexfile ./knexfile.core.js",
    "migrate:core:rollback": "knex migrate:rollback --knexfile ./knexfile.core.js",
    "migrate:core:make": "knex migrate:make --knexfile ./knexfile.core.js",
    "seed:core": "node scripts/seed-core-from-mydb.js",
    "test:core": "node scripts/smoke-core.js",
    "migrate:vitrine": "knex migrate:latest --knexfile ./knexfile.vitrine.js",
    "migrate:vitrine:rollback": "knex migrate:rollback --knexfile ./knexfile.vitrine.js",
    "migrate:vitrine:make": "knex migrate:make --knexfile ./knexfile.vitrine.js",
    "migrate:jogo": "knex migrate:latest --knexfile ./knexfile.jogo.js",
    "migrate:jogo:rollback": "knex migrate:rollback --knexfile ./knexfile.jogo.js",
    "migrate:jogo:make": "knex migrate:make --knexfile ./knexfile.jogo.js",
    "seed:vitrine": "node scripts/seed-vitrine-from-mydb.js",
    "seed:jogo": "node scripts/seed-jogo-from-mydb.js",
    "check-orphans": "node scripts/check-orphans.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "pg": "^8.20.0"
  }
}
